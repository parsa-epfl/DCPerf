# Django Workload 16-Core Configuration (32 cores total)

# Architecture Configuration
ARCH=arm64

# CPU Configuration (DB and Server share cores 0-15, Client uses cores 16-31)
SERVER_NODE_CPUS="0-15"
CLIENT_NODE_CPUS="16-31"

# Django Server Configuration
NUM_DJANGO_THREADS=

# Siege Client Configuration
NUM_CLIENT_THREADS=
ITERATIONS=70
REPS=
