SERVER_NODE_CPUS_INST2="4-7"
SERVER_NODE_CPUS_INST3="8-11"
SERVER_NODE_CPUS_INST4="12-15"
CLIENT_NODE_CPUS_INST1="16-19"
CLIENT_NODE_CPUS_INST2="20-23"
CLIENT_NODE_CPUS_INST3="24-27"
CLIENT_NODE_CPUS_INST4="28-31"

# Django Server Configuration
NUM_DJANGO_THREADS=

# Siege Client Configuration
NUM_CLIENT_THREADS=
