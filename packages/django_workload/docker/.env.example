# Django Workload Environment Configuration
# Copy this file to .env and customize for your setup
# Uses benchpress_cli.py commands as documented in README.md

# ==========================================
# Architecture Configuration
# ==========================================
# Target architecture: x86_64 or arm64
# Auto-detected if not set. Used to select appropriate base images and benchpress jobs.
# x86_64 → uses django_workload_default
# arm64  → uses django_workload_arm
# ARCH=x86_64


# ==========================================
# Cassandra Database Configuration
# ==========================================
# IP address for Cassandra to bind (leave empty for auto-detection via hostname -i)
# This corresponds to the bind_ip parameter in benchpress_cli.py
BIND_IP=


# ==========================================
# Django Server Configuration
# ==========================================
# Cassandra database address (hostname or IP)
# This corresponds to the db_addr parameter in benchpress_cli.py
# Default: cassandra-db (docker-compose service name)
DB_ADDR=cassandra-db


# ==========================================
# Siege Client Configuration
# ==========================================
# Django server address (hostname or IP)
# This corresponds to the server_addr parameter in benchpress_cli.py
# Default: django-server (docker-compose service name)
SERVER_ADDR=django-server

# Number of benchmark iterations (optional)
# This corresponds to the iterations parameter in benchpress_cli.py
# Leave empty to use default (7)
ITERATIONS=

# Fixed number of requests per iteration (optional)
# This corresponds to the reps parameter in benchpress_cli.py
# Leave empty to use default time-based benchmarking
# Useful to avoid Siege hanging issues on some platforms
REPS=
