# Django Workload Single-Core Configuration

# Architecture Configuration
ARCH=arm64

# CPU Configuration (DB and Server share core 0, Client uses core 1)
SERVER_NODE_CPUS="0"
CLIENT_NODE_CPUS="1"

# Django Server Configuration
NUM_DJANGO_THREADS=

# Siege Client Configuration
NUM_CLIENT_THREADS=
ITERATIONS=70
REPS=
