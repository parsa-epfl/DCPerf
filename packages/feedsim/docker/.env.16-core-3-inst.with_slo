# FeedSim 16-Core 3-Instance Configuration (96 cores total)

# Architecture Configuration
ARCH=arm64

# CPU affinity configuration - Per Instance
SERVER_NODE_CPUS_INST1="0-15"
CLIENT_NODE_CPUS_INST1="48-63"
SERVER_NODE_CPUS_INST2="16-31"
CLIENT_NODE_CPUS_INST2="64-79"
SERVER_NODE_CPUS_INST3="32-47"
CLIENT_NODE_CPUS_INST3="80-95"

# CPU and thread configuration
THRIFT_THREADS=42
RANKING_THREADS=16
SRV_IO_THREADS=16
EVENTBASE_THREADS=4
SRV_THREADS=8
DRIVER_THREADS=8

# Benchmark duration and load configuration
WARMUP_DURATION=10
FIXED_QPS_DURATION=300
FIXED_QPS=63
