# FeedSim 16-Core Configuration
# Architecture Configuration
ARCH=arm64

# CPU and thread configuration
THRIFT_THREADS=42
RANKING_THREADS=16
SRV_IO_THREADS=16
EVENTBASE_THREADS=4
SRV_THREADS=8
DRIVER_THREADS=8

# Benchmark duration and load configuration
WARMUP_DURATION=10
FIXED_QPS_DURATION=300
FIXED_QPS=63

# CPU affinity configuration (16 cores for server, 16 cores for client)
SERVER_NODE_CPUS="0-15"
CLIENT_NODE_CPUS="16-31"
