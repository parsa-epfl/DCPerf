# FeedSim Single-Core Configuration
# Architecture Configuration
ARCH=arm64

# CPU and thread configuration
THRIFT_THREADS=3
RANKING_THREADS=4
SRV_IO_THREADS=4
EVENTBASE_THREADS=2
SRV_THREADS=2
DRIVER_THREADS=1

# Benchmark duration and load configuration
WARMUP_DURATION=10
FIXED_QPS_DURATION=300
FIXED_QPS=1.6

# CPU affinity configuration
SERVER_NODE_CPUS="0"
CLIENT_NODE_CPUS="1"
